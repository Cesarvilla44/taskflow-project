{
  "version": 2,
  "builds": [
    {
      "src": "server/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static",
      "config": {
        "distDir": ""
      }
    },
    {
      "src": "client.js",
      "use": "@vercel/static",
      "config": {
        "distDir": ""
      }
    },
    {
      "src": "app.js",
      "use": "@vercel/static",
      "config": {
        "distDir": ""
      }
    },
    {
      "src": "output.css",
      "use": "@vercel/static",
      "config": {
        "distDir": ""
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/src/index.js"
    },
    {
      "src": "/client.js",
      "dest": "/client.js"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    },
    {
      "src": "/output.css",
      "dest": "/output.css"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
